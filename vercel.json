{
  "version": 2,
  "public": true,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "^/api/(.*)$", "dest": "/api/$1" },
    { "src": "^/admin$", "dest": "/admin.html" },
    { "src": "^/admin/(.*)$", "dest": "/admin.html" },
    { "src": "^/(.*)$", "dest": "/$1" }
  ]
}